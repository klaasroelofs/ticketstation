{
  "name": "ticketstation/site-vendor",
  "description": "Bundled runtime dependencies for the Ticketstation site component. This vendor folder is installed as part of the com_ticketstation package.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.3",
    "endroid/qr-code": "^6.0",
    "mollie/mollie-api-php": "^4.0",
    "setasign/fpdf": "^1.8.6",
    "setasign/fpdi": "^2.6.7"
  },
  "replace": {
    "psr/http-client": "*",
    "psr/http-factory": "*",
    "psr/http-message": "*",
    "symfony/var-dumper": "*"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
