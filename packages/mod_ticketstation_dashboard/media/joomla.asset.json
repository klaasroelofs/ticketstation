{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "mod_ticketstation_dashboard",
  "version": "auto",
  "description": "Ticketstation dashboard module assets",
  "license": "GPL-3.0-only",
  "assets": [
    {
      "name": "mod_ticketstation_dashboard.dashboard",
      "description": "Dashboard widget styles",
      "type": "style",
      "uri": "mod_ticketstation_dashboard/dashboard.css"
    },
    {
      "name": "mod_ticketstation_dashboard.door",
      "description": "Refreshes the figures of the door widget",
      "type": "script",
      "uri": "mod_ticketstation_dashboard/door.js",
      "dependencies": ["core"],
      "attributes": {
        "defer": true
      }
    }
  ]
}
