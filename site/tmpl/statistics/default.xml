<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_TICKETSTATION_MENU_STATISTICS_TITLE">
        <message><![CDATA[COM_TICKETSTATION_MENU_STATISTICS_DESC]]></message>
    </layout>

    <fields name="request">
        <fieldset name="request">
            <field
                    name="id"
                    type="sql"
                    query="SELECT t.ticketid, CONCAT(e.eventname, ' - ', t.ticketname) AS title
                            FROM #__ticketstation_tickets AS t
                            LEFT JOIN #__ticketstation_events AS e
                            ON (t.eventid = e.eventid)
                            ORDER BY t.startdate ASC"
                    key_field="ticketid"
                    value_field="title"
                    label="COM_TICKETSTATION_SELECT_EVENT_LABEL"
                    description="COM_TICKETSTATION_SELECT_EVENT_DESC"
            >
                <option value="">COM_TICKETSTATION_SELECT_EVENT_LABEL</option>
            </field>

            <field
                    name="salesstats"
                    type="list"
                    description="COM_TICKETSTATION_CHOOSE_SALESSTATS_DESC"
                    label="COM_TICKETSTATION_CHOOSE_SALESSTATS_LABEL"
                    default="ticket">
                <option value="ticket">COM_TICKETSTATION_CHOOSE_SALESSCANSTATS_TICKET</option>
                <option value="event">COM_TICKETSTATION_CHOOSE_SALESSCANSTATS_EVENT</option>
            </field>
            <field
                    name="salesperticket"
                    type="list"
                    description="COM_TICKETSTATION_SALES_PER_TICKET_DESC"
                    label="COM_TICKETSTATION_SALES_PER_TICKET_LABEL"
                    default="1">
                <option value="1">COM_TICKETSTATION_YES</option>
                <option value="0">COM_TICKETSTATION_NO</option>
            </field>
            <field
                    name="scanstats"
                    type="list"
                    description="COM_TICKETSTATION_CHOOSE_SCANSTATS_DESC"
                    label="COM_TICKETSTATION_CHOOSE_SCANSTATS_LABEL"
                    default="ticket">
                <option value="ticket">COM_TICKETSTATION_CHOOSE_SALESSCANSTATS_TICKET</option>
                <option value="event">COM_TICKETSTATION_CHOOSE_SALESSCANSTATS_EVENT</option>
            </field>
        </fieldset>
    </fields>

</metadata>