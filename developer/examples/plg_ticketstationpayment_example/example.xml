<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="ticketstationpayment" method="upgrade">

	<name>plg_ticketstationpayment_example</name>
	<creationDate>2026-10-06</creationDate>
	<author>Your name</author>
	<authorEmail>you@example.com</authorEmail>
	<copyright>Your name</copyright>
	<license>GPL v3</license>
	<version>1.0.0</version>
	<description>PLG_TICKETSTATIONPAYMENT_EXAMPLE_XML_DESCRIPTION</description>

	<!-- The namespace is yours; it only has to match the classes in src/. -->
	<namespace path="src">Example\Plugin\TicketstationPayment\Example</namespace>

	<files>
		<!-- plugin="example": the element of the plugin, and the id of its provider -->
		<folder plugin="example">services</folder>
		<folder>src</folder>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/plg_ticketstationpayment_example.ini</language>
		<language tag="en-GB">language/en-GB/plg_ticketstationpayment_example.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="secret"
					type="password"
					label="PLG_TICKETSTATIONPAYMENT_EXAMPLE_SECRET"
					description="PLG_TICKETSTATIONPAYMENT_EXAMPLE_SECRET_DESC"
					autocomplete="off"
					size="60"
				/>
			</fieldset>
		</fields>
	</config>

</extension>
