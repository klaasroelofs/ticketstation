<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">

	<name>Ticketstation</name>
	<packagename>ticketstation</packagename>
	<!-- Joomla takes the element from packagename; tools such as the JED Checker read it here. -->
	<element>pkg_ticketstation</element>
	<creationDate>2026-10-09</creationDate>
	<author>Klaas Roelofs</author>
	<authorEmail>klaasroelofs@huibuuke.nl</authorEmail>
	<authorUrl>https://www.huibuuke.nl</authorUrl>
	<copyright>© 2026 Klaas Roelofs</copyright>
	<license>GPL v3</license>
	<version>2.29.1-rc1</version>
	<description>PKG_TICKETSTATION_XML_DESCRIPTION</description>

	<scriptfile>pkg_script.php</scriptfile>

	<languages folder="language">
		<language tag="en-GB">en-GB/pkg_ticketstation.sys.ini</language>
		<language tag="nl-NL">nl-NL/pkg_ticketstation.sys.ini</language>
	</languages>

	<files folder="packages">
		<file type="component" id="com_ticketstation">com_ticketstation.zip</file>
		<file type="module" client="site" id="mod_ticketstation_basket">mod_ticketstation_basket.zip</file>
		<file type="plugin" group="task" id="ticketstation">plg_task_ticketstation.zip</file>
		<file type="plugin" group="system" id="ticketstation">plg_system_ticketstation.zip</file>
		<file type="plugin" group="ticketstationpayment" id="mollie">plg_ticketstationpayment_mollie.zip</file>
		<file type="plugin" group="ticketstationpayment" id="stripe">plg_ticketstationpayment_stripe.zip</file>
	</files>

	<updateservers>
		<server type="extension" priority="1" name="Ticketstation">https://github.com/klaasroelofs/ticketstation/releases/latest/download/pkg_ticketstation_update.xml</server>
	</updateservers>

</extension>
